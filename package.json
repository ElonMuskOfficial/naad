{
  "name": "naad",
  "version": "1.0.0",
  "private": true,
  "description": "NAAD — a caching proxy for JioSaavn: search, browse, audio links, home feed, radio stations, podcasts and lyrics.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/fastify-cli/cli.js start -w -o -l info -P app.js",
    "start": "node --env-file-if-exists=.env node_modules/fastify-cli/cli.js start -o -a 0.0.0.0 -l info app.js",
    "typecheck": "tsc -p jsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.5",
    "fastify": "^5.12.5",
    "fastify-cli": "^8.0.2",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.0.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.0"
  }
}
