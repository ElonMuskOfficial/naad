# NAAD configuration. Copy to .env. `npm start` and `npm run dev` load it automatically.

NODE_ENV=production
# fastify start reads PORT (default 3000)
PORT=8080
# Comma-separated origins allowed to call the API from a browser (your frontend)
CORS_ORIGINS=https://app.example.com
# Behind a reverse proxy, list the proxies (IPs/CIDRs, or loopback/linklocal/uniquelocal) whose
# X-Forwarded-For is believed; add Cloudflare's ranges (https://www.cloudflare.com/ips/) if it is in front.
# The client IP keys the rate limit and is forwarded to JioSaavn, which localizes results by it. `true`
# believes any X-Forwarded-For, so clients can spoof it. Unset when nothing is in front of naad.
TRUST_PROXY=uniquelocal

# Redis is the only store, and it only caches JioSaavn responses and lyrics.
REDIS_URL=redis://127.0.0.1:6379/0

# /v1 routes (except artwork) require "Authorization: Bearer <key>". Required when NODE_ENV=production.
NAAD_API_KEY=
# Trusted private networks only: run in production without a key.
ALLOW_UNAUTHENTICATED=false
RATE_LIMIT_PER_MINUTE=240

# The library (likes, playlists, history) is the only persistent state. Point this at its own Redis that never
# evicts (maxmemory-policy noeviction; on Upstash: Eviction switched OFF in the console, it cannot be checked from
# here). Unset, it shares REDIS_URL (fine for local use, not for production).
LIBRARY_REDIS_URL=
